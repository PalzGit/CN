#include <iostream>
#include <string>
using namespace std;

int main() {
    string bits;

    cout << "Enter 4 bit binary data: ";
    cin >> bits;

    if (bits.length() != 4) {
        cout << "Invalid input. Enter exactly 4 bits." << endl;
        return 0;
    }

    for (int i = 0; i < bits.length(); i++) {
        if (bits[i] != '0' && bits[i] != '1') {
            cout << "Invalid input. Only 0 and 1 are allowed." << endl;
            return 0;
        }
    }

    int dataLength = 4;
    int parityCount = 0;

    while ((1 << parityCount) < dataLength + parityCount + 1)
        parityCount++;

    cout << "Data Bits:" << bits << endl;
    cout << "Number of Parity bits:" << parityCount << endl;

    char h[8];

    h[1] = 'P';
    h[2] = 'P';
    h[3] = bits[3];
    h[4] = 'P';
    h[5] = bits[2];
    h[6] = bits[1];
    h[7] = bits[0];

    cout << "\nHamming code positions:" << endl;

    for (int position = 1; position <= 7; position++)
        cout << "Position " << position << ": " << h[position] << endl;

    for (int parityPosition = 1; parityPosition <= 4; parityPosition *= 2) {

        int value = 0;

        cout << "P" << parityPosition << " checks positions: ";

        for (int position = 1; position <= 7; position++) {

            if ((position & parityPosition) != 0) {
                cout << position << " ";

                if (position != parityPosition)
                    value ^= h[position] - '0';
            }
        }

        h[parityPosition] = value + '0';

        cout << "-> P" << parityPosition
             << " = " << h[parityPosition] << endl;
    }

    cout << "\nParity Bits:" << endl;
    cout << "P1 = " << h[1] << endl;
    cout << "P2 = " << h[2] << endl;
    cout << "P3 = " << h[4] << endl;

    cout << "\nFinal Hamming Code: ";

    for (int i = 1; i <= 7; i++)
        cout << h[i];

    cout << endl;

    return 0;
}
