import socket

SERVER_ADDRESS = ("127.0.0.1", 9998)

client_socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
client_socket.settimeout(5.0)

print("UDP Client started!")

try:
    while True:
        print("\n1. Convert to lowercase")
        print("2. Convert to uppercase")
        print("3. Reverse string")
        print("4. Exit")

        choice = input("Enter your choice: ").strip()

        if choice == "4":
            print("Client closed.")
            break

        if choice not in ("1", "2", "3"):
            print("Invalid choice. Please enter 1, 2, 3, or 4.")
            continue

        message = input("Enter a string: ")

        # Send choice and message to the server
        request = f"{choice}|{message}"
        client_socket.sendto(
            request.encode("utf-8"), SERVER_ADDRESS
        )

        try:
            # Receive the server response
            response, _ = client_socket.recvfrom(4096)
            print("Server response:", response.decode("utf-8"))

        except socket.timeout:
            print("No response from server. Check that it is running.")

        again = input("\nDo you want to continue? (yes/no): ").strip().lower()

        if again in ("no", "n"):
            print("Client closed.")
            break

except KeyboardInterrupt:
    print("\nClient interrupted.")

finally:
    client_socket.close()
