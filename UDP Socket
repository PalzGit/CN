import socket

HOST = "127.0.0.1"
PORT = 9998

server_socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
server_socket.bind((HOST, PORT))

print(f"UDP Server running on {HOST}:{PORT}")

try:
    while True:
        data, client_address = server_socket.recvfrom(4096)

        try:
            request = data.decode("utf-8")
            choice, message = request.split("|", 1)

            if choice == "1":
                response = message.lower()
            elif choice == "2":
                response = message.upper()
            elif choice == "3":
                response = message[::-1]
            else:
                response = "Invalid choice. Please select 1, 2, or 3."

        except (UnicodeDecodeError, ValueError):
            response = "Invalid request format. Use choice|message."

        server_socket.sendto(
            response.encode("utf-8"), client_address
        )

        print(f"Client {client_address}: {response}")

except KeyboardInterrupt:
    print("\nUDP Server shutting down.")

finally:
    server_socket.close()
